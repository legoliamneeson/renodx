+			if (!validate_only) { gl.GetUniformdv(original, u.source, d); gl.ProgramUniformMatrix4x3dv(replacement, u.destination, 1, GL_FALSE, d); }
+			return true;
+		case GL_SAMPLER_1D:
+		case GL_SAMPLER_2D:
+		case GL_SAMPLER_3D:
+		case GL_SAMPLER_CUBE:
+		case GL_SAMPLER_1D_SHADOW:
+		case GL_SAMPLER_2D_SHADOW:
