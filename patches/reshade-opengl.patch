+GLuint APIENTRY glCreateShader(GLenum type)
+{
+	static const auto trampoline = reshade::hooks::call(glCreateShader);
+	const GLuint shader = trampoline(type);
+#if RESHADE_ADDON
+	if (g_opengl_context && shader != 0)
+	{
+		const auto device = static_cast<reshade::opengl::device_impl *>(g_opengl_context->get_device());
+		std::lock_guard lock(device->shader_capture_mutex);
+		device->shader_binaries.erase(shader);
+	}
+#endif
+	return shader;
+}
+void APIENTRY glDeleteShader(GLuint shader)
