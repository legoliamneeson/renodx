+void APIENTRY glShaderBinary(GLsizei count, const GLuint *shaders, GLenum format, const void *binary, GLsizei length)
+{
+	static const auto trampoline = reshade::hooks::call(glShaderBinary);
+	trampoline(count, shaders, format, binary, length);
+#if RESHADE_ADDON
+	if (g_opengl_context && count > 0 && shaders && binary && length >= 20 && length % 4 == 0 && format == GL_SHADER_BINARY_FORMAT_SPIR_V)
+	{
+		const auto device = static_cast<reshade::opengl::device_impl *>(g_opengl_context->get_device());
+		std::lock_guard lock(device->shader_capture_mutex);
+		for (GLsizei i = 0; i < count; ++i)
+		{
+			if (!gl.IsShader(shaders[i])) continue;
+			GLint is_spirv = GL_FALSE;
+			gl.GetShaderiv(shaders[i], GL_SPIR_V_BINARY, &is_spirv);
+			if (!is_spirv) continue;
+			auto &data = device->shader_binaries[shaders[i]];
+			data = {};
+			data.code.assign(static_cast<const char *>(binary), static_cast<const char *>(binary) + length);
+		}
+	}
+#endif
+}
+static void capture_shader_specialization(GLuint shader, const GLchar *entry, GLuint count, const GLuint *ids, const GLuint *values)
+{
+#if RESHADE_ADDON
+	if (g_opengl_context && entry && (count == 0 || (ids && values)))
+	{
+		GLint compiled = GL_FALSE;
+		gl.GetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+		if (!compiled) return;
+		const auto device = static_cast<reshade::opengl::device_impl *>(g_opengl_context->get_device());
+		std::lock_guard lock(device->shader_capture_mutex);
+		const auto it = device->shader_binaries.find(shader);
+		if (it != device->shader_binaries.end())
+		{
+			it->second.entry_point = entry;
+			it->second.ids.clear(); it->second.values.clear();
+			if (count) { it->second.ids.assign(ids, ids + count); it->second.values.assign(values, values + count); }
+		}
+	}
+#endif
+}
+void APIENTRY glSpecializeShader(GLuint shader, const GLchar *entry, GLuint count, const GLuint *ids, const GLuint *values)
+{
+	static const auto trampoline = reshade::hooks::call(glSpecializeShader);
+	trampoline(shader, entry, count, ids, values);
+	capture_shader_specialization(shader, entry, count, ids, values);
+}
